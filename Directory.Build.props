<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>3.1.0.15</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(POPROSHAYKA_BUILD_SLOT)' != ''">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(POPROSHAYKA_BUILD_SLOT)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\$(POPROSHAYKA_BUILD_SLOT)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' Or '$(RuntimeIdentifiers)' != ''">
    <_RidLockFileSuffix>$(RuntimeIdentifier)</_RidLockFileSuffix>
    <_RidLockFileSuffix Condition="'$(_RidLockFileSuffix)' == ''">$(RuntimeIdentifiers.Replace(';', '-'))</_RidLockFileSuffix>
    <_RidLockFileDirectory>$(MSBuildProjectDirectory)\obj</_RidLockFileDirectory>
    <_RidLockFileDirectory Condition="'$(POPROSHAYKA_BUILD_SLOT)' != ''">$(MSBuildProjectDirectory)\obj\$(POPROSHAYKA_BUILD_SLOT)</_RidLockFileDirectory>
    <NuGetLockFilePath>$(_RidLockFileDirectory)\packages.$(_RidLockFileSuffix).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
