<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.DebugChannelSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DebugChannelSectionViewModel}"
             d:DesignHeight="360"
             d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RecentChannelRow"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="0,0,0,1" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource Bg.SurfaceMute}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecentChannelRowButton"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Padding"
                        Value="12,0" />
                <Setter Property="MinHeight"
                        Value="34" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch" />
                <Setter Property="FocusVisualStyle"
                        Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />

                                <Border x:Name="Outline"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused"
                                         Value="True">
                                    <Setter TargetName="Outline"
                                            Property="BorderBrush"
                                            Value="{DynamicResource Accent.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <CheckBox Style="{StaticResource CheckBox.Default}"
                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                  Content="Подключаться к чужому каналу (режим отладки)"
                  Margin="0,0,0,4" />

        <TextBlock Text="Бот будет читать чат указанного канала вместо вашего."
                   Style="{StaticResource Form.CheckHint}"
                   Margin="0,0,0,16" />

        <DockPanel>
            <TextBlock Text="Канал"
                       Style="{StaticResource Setting.RowLabel}" />
            <TextBox Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsEnabled}"
                     Width="{DynamicResource Setting.ShortFieldWidth}"
                     HorizontalAlignment="Left"
                     AutomationProperties.Name="Канал для режима отладки"
                     keepshell:PlaceholderBehavior.Placeholder="например, dunduk" />
        </DockPanel>

        <TextBlock Text="{Binding HintText}"
                   TextWrapping="Wrap"
                   Margin="200,6,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="FontSize"
                            Value="{DynamicResource Font.Size.S}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HintSeverity}"
                                     Value="Success">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource State.SuccessText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HintSeverity}"
                                     Value="Warning">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource State.WarningText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HintSeverity}"
                                     Value="Error">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource State.ErrorText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel DataContext="{Binding Recent}"
                   LastChildFill="False"
                   Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left"
                       Text="Недавние каналы"
                       Style="{StaticResource Form.Label}"
                       VerticalAlignment="Center"
                       Margin="0" />

            <Button x:Name="RefreshRecentButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding RefreshCommand}"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Проверить, кто из этих каналов сейчас в эфире"
                    AutomationProperties.Name="Обновить состояние недавних каналов">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.RefreshCw}"
                                             Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                    <TextBlock Text="Обновить"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <TextBlock DataContext="{Binding Recent}"
                   Text="Здесь появятся каналы, к которым бот подключался в режиме отладки. Нажмите на канал, чтобы подставить его в поле."
                   Style="{StaticResource Form.Hint}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}"
                   Margin="0,0,0,16" />

        <StackPanel DataContext="{Binding Recent}"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,16">
            <Border BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="0,1,0,0">
                <ItemsControl x:Name="RecentChannelsList"
                              ItemsSource="{Binding Rows}"
                              Focusable="False"
                              AutomationProperties.Name="Недавние каналы">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecentDebugChannelRowViewModel}">
                            <Border Style="{StaticResource RecentChannelRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Style="{StaticResource RecentChannelRowButton}"
                                            Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Details}"
                                            AutomationProperties.Name="{Binding Summary}"
                                            AutomationProperties.HelpText="Подставить канал в поле и включить режим отладки">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"
                                                     keepshell:SeverityBrushBehavior.Fill="{Binding Severity}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Login}"
                                                       Foreground="{DynamicResource Fg.Primary}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StateText}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       keepshell:SeverityBrushBehavior.Foreground="{Binding Severity}" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding UsedText}"
                                                       ToolTip="{Binding UsedTooltip}"
                                                       Foreground="{DynamicResource Fg.Secondary}"
                                                       FontSize="{DynamicResource Font.Size.S}"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0" />
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource Button.Icon}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Убрать из списка"
                                            AutomationProperties.Name="{Binding Login, StringFormat='Убрать канал {0} из списка'}"
                                            VerticalAlignment="Center"
                                            Margin="4,0,4,0">
                                        <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.X}"
                                                                 Width="12"
                                                                 Height="12"
                                                                 Foreground="{DynamicResource Fg.Secondary}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding Note}"
                       Style="{StaticResource Form.Hint}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <CheckBox Style="{StaticResource CheckBox.Default}"
                  IsChecked="{Binding AllowSending, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled}"
                  Content="Разрешить боту писать в этот чат"
                  Margin="0,0,0,4" />

        <TextBlock Text="По умолчанию бот молчит: сообщения, которые он собирался отправить, попадают только в журнал."
                   Style="{StaticResource Form.CheckHint}"
                   Margin="0,0,0,16" />

        <TextBlock Style="{StaticResource Form.Hint}"
                   TextWrapping="Wrap"
                   Text="На чужом канале доступно только чтение чата: голосования, смена названия и категории не работают – права есть лишь на ваш собственный канал. Плитка «Чат» – это настоящая страница Twitch под аккаунтом бота: то, что вы наберёте в её поле ввода руками, уйдёт в чужой чат в обход этой настройки. Новый канал подхватывается при следующем подключении бота. Статистика и очки зрителей пишутся в обычный профиль; для чистого прогона запускайте scripts/run-debug.ps1 – он поднимает отдельную папку данных." />
    </StackPanel>

</UserControl>
