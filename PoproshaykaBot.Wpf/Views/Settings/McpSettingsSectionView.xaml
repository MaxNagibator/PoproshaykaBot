<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.McpSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:McpSettingsSectionViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Form.Hint}"
                   Margin="0,0,0,0"
                   Text="Встроенный сервер на loopback: агент подключается к запущенному окну и видит то же, что вы – открытую страницу, дерево контролов, журнал, кадр. Нужен только для отладки, в обычной работе держите выключенным." />

        <CheckBox Content="Поднимать сервер"
                  IsChecked="{Binding Preferences.Enabled, Mode=TwoWay}"
                  Margin="0,14,0,16"
                  VerticalAlignment="Center" />

        <StackPanel Style="{StaticResource Setting.DependentBlock}"
                    IsEnabled="{Binding Preferences.Enabled}">
            <DockPanel>
                <TextBlock Text="Порт"
                           Style="{StaticResource Setting.RowLabel}" />
                <TextBox Text="{Binding Preferences.Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         HorizontalAlignment="Left"
                         Width="{DynamicResource Setting.ShortFieldWidth}"
                         FontFamily="{DynamicResource Font.Mono}"
                         AutomationProperties.Name="Порт MCP-сервера" />
            </DockPanel>
            <TextBlock Style="{StaticResource Form.Hint}"
                       Margin="200,6,0,0"
                       Text="1024…65535, только 127.0.0.1. Смена порта применяется сразу – сервер перезапускается." />
        </StackPanel>

        <CheckBox Content="Разрешить изменяющие операции"
                  IsChecked="{Binding Preferences.AllowMutations, Mode=TwoWay}"
                  Margin="0,16,0,0"
                  VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource Form.CheckHint}"
                   Text="Один флаг на всё: агент сможет нажимать кнопки, вводить текст, закрывать приложение, подключать и отключать бота. Без флага доступно только чтение." />

        <DockPanel Margin="0,16,0,0">
            <TextBlock Text="Токен"
                       Style="{StaticResource Setting.RowLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Preferences.Token, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}"
                         AutomationProperties.Name="Токен доступа MCP" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="8,0,0,0">
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding Preferences.RegenerateTokenCommand}"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="Перегенерировать токен"
                            ToolTip="Выдать новый токен – старые подключения агентов отвалятся">
                        <iconPacks:PackIconLucide Kind="RefreshCw"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}"
                            Command="{Binding CopyTokenCommand}"
                            AutomationProperties.Name="Скопировать токен"
                            ToolTip="Скопировать токен в буфер обмена">
                        <iconPacks:PackIconLucide Kind="Clipboard"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>

        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0">
            <iconPacks:PackIconLucide Kind="Radio"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Foreground="{DynamicResource State.Success}"
                                      Visibility="{Binding Server.IsRunning, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Сервер работает" />
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding Server.LastError}"
                   Foreground="{DynamicResource State.Error}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding Server.LastError, Converter={StaticResource NullToVisibility}}" />

        <Border Padding="12,10"
                Margin="0,14,0,0"
                Background="{DynamicResource State.WarningSoft}"
                BorderBrush="{DynamicResource State.Warning}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Visibility="{Binding Server.IsElevated, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="TriangleAlert"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource State.Warning}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          AutomationProperties.Name="Внимание" />
                <TextBlock Grid.Column="1"
                           Text="Приложение запущено с правами администратора, а токен лежит открытым текстом в файле настроек. Любой процесс под вашим пользователем получит админский доступ к окну."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock Text="Строка подключения"
                           Style="{StaticResource Setting.RowLabel}"
                           VerticalAlignment="Top"
                           Margin="0,6,12,0" />
                <TextBox Text="{Binding ConnectSnippet, Mode=OneWay}"
                         IsReadOnly="True"
                         MaxHeight="180"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource Font.Size.S}"
                         AutomationProperties.Name="Строка подключения к MCP-серверу в формате JSON" />
            </DockPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Icon}"
                    Command="{Binding CopyConnectSnippetCommand}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Скопировать строку подключения"
                    ToolTip="Скопировать JSON для .mcp.json агента">
                <iconPacks:PackIconLucide Kind="Clipboard"
                                          Width="16"
                                          Height="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
