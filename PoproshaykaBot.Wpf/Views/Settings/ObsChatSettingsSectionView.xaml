<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.ObsChatSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ObsChatSettingsSectionViewModel}"
             d:DesignWidth="720">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RowCombo"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource ComboBox.Form}">
                <Setter Property="Width"
                        Value="240" />
                <Setter Property="HorizontalAlignment"
                        Value="Left" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="Цвета"
                   Style="{StaticResource Setting.GroupHeading}"
                   Margin="0,0,0,10" />

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Фон"
                       Style="{StaticResource Setting.RowLabel}" />
            <Button DockPanel.Dock="Right"
                    Content="Сброс"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ResetColorCommand}"
                    CommandParameter="Background"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Изменить"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding PickColorCommand}"
                    CommandParameter="Background" />
            <Border Height="28"
                    CornerRadius="{DynamicResource Radius.M}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Background="{Binding BackgroundColor, Converter={StaticResource DrawingColorToBrush}}"
                    Margin="0,0,12,0" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Текст"
                       Style="{StaticResource Setting.RowLabel}" />
            <Button DockPanel.Dock="Right"
                    Content="Сброс"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ResetColorCommand}"
                    CommandParameter="Text"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Изменить"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding PickColorCommand}"
                    CommandParameter="Text" />
            <Border Height="28"
                    CornerRadius="{DynamicResource Radius.M}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Background="{Binding TextColor, Converter={StaticResource DrawingColorToBrush}}"
                    Margin="0,0,12,0" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Имя пользователя"
                       Style="{StaticResource Setting.RowLabel}" />
            <Button DockPanel.Dock="Right"
                    Content="Сброс"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ResetColorCommand}"
                    CommandParameter="Username"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Изменить"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding PickColorCommand}"
                    CommandParameter="Username" />
            <Border Height="28"
                    CornerRadius="{DynamicResource Radius.M}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Background="{Binding UsernameColor, Converter={StaticResource DrawingColorToBrush}}"
                    Margin="0,0,12,0" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Системные сообщения"
                       Style="{StaticResource Setting.RowLabel}" />
            <Button DockPanel.Dock="Right"
                    Content="Сброс"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ResetColorCommand}"
                    CommandParameter="System"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Изменить"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding PickColorCommand}"
                    CommandParameter="System" />
            <Border Height="28"
                    CornerRadius="{DynamicResource Radius.M}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Background="{Binding SystemMessageColor, Converter={StaticResource DrawingColorToBrush}}"
                    Margin="0,0,12,0" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Время"
                       Style="{StaticResource Setting.RowLabel}" />
            <Button DockPanel.Dock="Right"
                    Content="Сброс"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ResetColorCommand}"
                    CommandParameter="Timestamp"
                    Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Content="Изменить"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding PickColorCommand}"
                    CommandParameter="Timestamp" />
            <Border Height="28"
                    CornerRadius="{DynamicResource Radius.M}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Background="{Binding TimestampColor, Converter={StaticResource DrawingColorToBrush}}"
                    Margin="0,0,12,0" />
        </DockPanel>

        <TextBlock Text="Шрифт"
                   Style="{StaticResource Setting.GroupHeading}" />

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Семейство шрифтов"
                       Style="{StaticResource Setting.RowLabel}" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     keepshell:PlaceholderBehavior.Placeholder="Например: Inter, Arial, sans-serif"
                     AutomationProperties.Name="Семейство шрифтов"
                     Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <WrapPanel>
            <keepshell:NumericSettingField Style="{StaticResource Setting.PairCell}"
                                           Label="Размер шрифта"
                                           Value="{Binding FontSize, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseFontSizeCommand}"
                                           DecreaseCommand="{Binding DecreaseFontSizeCommand}"
                                           IncreaseAutomationName="Увеличить размер шрифта"
                                           DecreaseAutomationName="Уменьшить размер шрифта" />

            <CheckBox Style="{StaticResource CheckBox.Default}"
                      Content="Жирный шрифт"
                      IsChecked="{Binding FontBold, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,0,8" />
        </WrapPanel>

        <WrapPanel>
            <StackPanel Style="{StaticResource Setting.PairCell}">
                <TextBlock Text="Геометрия"
                           Style="{StaticResource Setting.GroupHeading}" />

                <keepshell:NumericSettingField Label="Внутренний отступ"
                                               Value="{Binding Padding, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreasePaddingCommand}"
                                               DecreaseCommand="{Binding DecreasePaddingCommand}"
                                               IncreaseAutomationName="Увеличить внутренний отступ"
                                               DecreaseAutomationName="Уменьшить внутренний отступ"
                                               Margin="0,0,0,8" />

                <keepshell:NumericSettingField Label="Внешний отступ"
                                               Value="{Binding Margin, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseMarginCommand}"
                                               DecreaseCommand="{Binding DecreaseMarginCommand}"
                                               IncreaseAutomationName="Увеличить внешний отступ"
                                               DecreaseAutomationName="Уменьшить внешний отступ"
                                               Margin="0,0,0,8" />

                <keepshell:NumericSettingField Label="Скругление углов"
                                               Value="{Binding BorderRadius, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseBorderRadiusCommand}"
                                               DecreaseCommand="{Binding DecreaseBorderRadiusCommand}"
                                               IncreaseAutomationName="Увеличить скругление углов"
                                               DecreaseAutomationName="Уменьшить скругление углов" />
            </StackPanel>

            <StackPanel Style="{StaticResource Setting.PairCell}">
                <TextBlock Text="Сообщения"
                           Style="{StaticResource Setting.GroupHeading}" />

                <keepshell:NumericSettingField Label="Максимум сообщений"
                                               Value="{Binding MaxMessages, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseMaxMessagesCommand}"
                                               DecreaseCommand="{Binding DecreaseMaxMessagesCommand}"
                                               IncreaseAutomationName="Увеличить максимум сообщений"
                                               DecreaseAutomationName="Уменьшить максимум сообщений"
                                               Margin="0,0,0,8" />

                <keepshell:NumericSettingField Label="Размер эмодзи, px"
                                               Value="{Binding EmoteSizePixels, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseEmoteSizeCommand}"
                                               DecreaseCommand="{Binding DecreaseEmoteSizeCommand}"
                                               IncreaseAutomationName="Увеличить размер эмодзи"
                                               DecreaseAutomationName="Уменьшить размер эмодзи"
                                               Margin="0,0,0,8" />

                <keepshell:NumericSettingField Label="Размер значков, px"
                                               Value="{Binding BadgeSizePixels, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseBadgeSizeCommand}"
                                               DecreaseCommand="{Binding DecreaseBadgeSizeCommand}"
                                               IncreaseAutomationName="Увеличить размер значков"
                                               DecreaseAutomationName="Уменьшить размер значков"
                                               Margin="0,0,0,8" />

                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Показывать время"
                          IsChecked="{Binding ShowTimestamp, Mode=TwoWay}" />
            </StackPanel>
        </WrapPanel>

        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="Открыть демо анимаций"
                    Style="{StaticResource Button.Secondary}"
                    VerticalAlignment="Bottom"
                    Command="{Binding OpenAnimationsDemoCommand}"
                    Margin="12,0,0,6" />
            <TextBlock Text="Анимация"
                       Style="{StaticResource Setting.GroupHeading}" />
        </DockPanel>

        <CheckBox Style="{StaticResource CheckBox.Default}"
                  Content="Анимировать появление сообщений"
                  IsChecked="{Binding EnableAnimations, Mode=TwoWay}"
                  Margin="0,0,0,8" />

        <StackPanel Style="{StaticResource Setting.DependentBlock}"
                    IsEnabled="{Binding EnableAnimations}">
            <keepshell:NumericSettingField Label="Длительность появления, мс"
                                           Value="{Binding AnimationDuration, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseAnimationDurationCommand}"
                                           DecreaseCommand="{Binding DecreaseAnimationDurationCommand}"
                                           IncreaseAutomationName="Увеличить длительность появления"
                                           DecreaseAutomationName="Уменьшить длительность появления"
                                           Margin="0,0,0,8" />

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Сообщения пользователей"
                           Style="{StaticResource Setting.RowLabel}" />
                <ComboBox Style="{StaticResource RowCombo}"
                          ItemsSource="{Binding EntryAnimationOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Анимация появления сообщений пользователей"
                          SelectedValue="{Binding UserMessageAnimation, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Сообщения бота"
                           Style="{StaticResource Setting.RowLabel}" />
                <ComboBox Style="{StaticResource RowCombo}"
                          ItemsSource="{Binding EntryAnimationOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Анимация появления сообщений бота"
                          SelectedValue="{Binding BotMessageAnimation, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Системные сообщения"
                           Style="{StaticResource Setting.RowLabel}" />
                <ComboBox Style="{StaticResource RowCombo}"
                          ItemsSource="{Binding EntryAnimationOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Анимация появления системных сообщений"
                          SelectedValue="{Binding SystemMessageAnimation, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Сообщения стримера"
                           Style="{StaticResource Setting.RowLabel}" />
                <ComboBox Style="{StaticResource RowCombo}"
                          ItemsSource="{Binding EntryAnimationOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Анимация появления сообщений стримера"
                          SelectedValue="{Binding BroadcasterMessageAnimation, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Первое сообщение зрителя"
                           Style="{StaticResource Setting.RowLabel}" />
                <ComboBox Style="{StaticResource RowCombo}"
                          ItemsSource="{Binding EntryAnimationOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Анимация появления первого сообщения зрителя"
                          SelectedValue="{Binding FirstTimeUserMessageAnimation, Mode=TwoWay}" />
            </DockPanel>
        </StackPanel>

        <CheckBox Style="{StaticResource CheckBox.Default}"
                  Content="Скрывать старые сообщения"
                  IsChecked="{Binding EnableMessageFadeOut, Mode=TwoWay}"
                  Margin="0,12,0,8" />

        <StackPanel Style="{StaticResource Setting.DependentBlock}"
                    IsEnabled="{Binding EnableMessageFadeOut}">
            <keepshell:NumericSettingField Label="Время жизни, с"
                                           Value="{Binding MessageLifetimeSeconds, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseMessageLifetimeCommand}"
                                           DecreaseCommand="{Binding DecreaseMessageLifetimeCommand}"
                                           IncreaseAutomationName="Увеличить время жизни"
                                           DecreaseAutomationName="Уменьшить время жизни"
                                           Margin="0,0,0,8" />

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Анимация исчезновения"
                           Style="{StaticResource Setting.RowLabel}" />
                <ComboBox Style="{StaticResource RowCombo}"
                          ItemsSource="{Binding ExitAnimationOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Анимация исчезновения сообщений"
                          SelectedValue="{Binding FadeOutAnimationType, Mode=TwoWay}" />
            </DockPanel>

            <keepshell:NumericSettingField Label="Длительность исчезновения, мс"
                                           Value="{Binding FadeOutAnimationDurationMs, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseFadeOutAnimationDurationCommand}"
                                           DecreaseCommand="{Binding DecreaseFadeOutAnimationDurationCommand}"
                                           IncreaseAutomationName="Увеличить длительность исчезновения"
                                           DecreaseAutomationName="Уменьшить длительность исчезновения"
                                           Margin="0,0,0,8" />
        </StackPanel>

        <TextBlock Text="Подсветка и эффекты"
                   Style="{StaticResource Setting.GroupHeading}" />

        <WrapPanel>
            <CheckBox Style="{StaticResource Setting.CheckCell}"
                      Content="Рамки по типу пользователя"
                      IsChecked="{Binding ShowUserTypeBorders, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Setting.CheckCell}"
                      Content="Выделять новых зрителей"
                      IsChecked="{Binding HighlightFirstTimeUsers, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Setting.CheckCell}"
                      Content="Выделять упоминания"
                      IsChecked="{Binding HighlightMentions, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Setting.CheckCell}"
                      Content="Тени сообщений"
                      IsChecked="{Binding EnableMessageShadows, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Setting.CheckCell}"
                      Content="Специальные эффекты"
                      IsChecked="{Binding EnableSpecialEffects, Mode=TwoWay}" />
        </WrapPanel>

        <WrapPanel>
            <StackPanel Style="{StaticResource Setting.PairCell}">
                <TextBlock Text="Прокрутка"
                           Style="{StaticResource Setting.GroupHeading}" />

                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Автопрокрутка"
                          IsChecked="{Binding AutoScrollEnabled, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Плавная прокрутка"
                          IsChecked="{Binding EnableSmoothScroll, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <keepshell:NumericSettingField Label="Длительность прокрутки, мс"
                                               Value="{Binding ScrollAnimationDuration, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseScrollAnimationDurationCommand}"
                                               DecreaseCommand="{Binding DecreaseScrollAnimationDurationCommand}"
                                               IncreaseAutomationName="Увеличить длительность прокрутки"
                                               DecreaseAutomationName="Уменьшить длительность прокрутки" />
            </StackPanel>

            <StackPanel Style="{StaticResource Setting.PairCell}">
                <TextBlock Text="Аватары"
                           Style="{StaticResource Setting.GroupHeading}" />

                <CheckBox Style="{StaticResource CheckBox.Default}"
                          Content="Показывать аватары пользователей"
                          IsChecked="{Binding ShowUserAvatars, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <StackPanel Style="{StaticResource Setting.DependentBlock}"
                            IsEnabled="{Binding ShowUserAvatars}">
                    <keepshell:NumericSettingField Label="Размер аватара, px"
                                                   Value="{Binding UserAvatarSizePixels, Mode=TwoWay}"
                                                   IncreaseCommand="{Binding IncreaseUserAvatarSizeCommand}"
                                                   DecreaseCommand="{Binding DecreaseUserAvatarSizeCommand}"
                                                   IncreaseAutomationName="Увеличить размер аватара"
                                                   DecreaseAutomationName="Уменьшить размер аватара" />
                </StackPanel>
            </StackPanel>
        </WrapPanel>

        <TextBlock Text="Картинки в сообщениях"
                   Style="{StaticResource Setting.GroupHeading}" />

        <CheckBox Style="{StaticResource CheckBox.Default}"
                  Content="Показывать картинку по ссылке из сообщения"
                  IsChecked="{Binding ShowMessageImages, Mode=TwoWay}"
                  Margin="0,0,0,8" />

        <StackPanel Style="{StaticResource Setting.DependentBlock}"
                    IsEnabled="{Binding ShowMessageImages}">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Чьи ссылки показывать"
                           Style="{StaticResource Setting.RowLabel}" />
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource CheckBox.Default}"
                              Content="Стример"
                              IsChecked="{Binding MessageImagesFromBroadcaster, Mode=TwoWay}"
                              Margin="0,2,16,2" />
                    <CheckBox Style="{StaticResource CheckBox.Default}"
                              Content="Модераторы"
                              IsChecked="{Binding MessageImagesFromModerators, Mode=TwoWay}"
                              Margin="0,2,16,2" />
                    <CheckBox Style="{StaticResource CheckBox.Default}"
                              Content="VIP"
                              IsChecked="{Binding MessageImagesFromVips, Mode=TwoWay}"
                              Margin="0,2,16,2" />
                    <CheckBox Style="{StaticResource CheckBox.Default}"
                              Content="Подписчики"
                              IsChecked="{Binding MessageImagesFromSubscribers, Mode=TwoWay}"
                              Margin="0,2,16,2" />
                    <CheckBox Style="{StaticResource CheckBox.Default}"
                              Content="Все зрители"
                              IsChecked="{Binding MessageImagesFromEveryone, Mode=TwoWay}"
                              Margin="0,2,0,2" />
                </WrapPanel>
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Разрешённые хосты"
                           Style="{StaticResource Setting.RowLabel}"
                           VerticalAlignment="Top" />
                <TextBox Style="{StaticResource TextBox.Form}"
                         AcceptsReturn="True"
                         MinHeight="96"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AutomationProperties.Name="Разрешённые хосты для картинок, по одному в строке"
                         keepshell:PlaceholderBehavior.Placeholder="По одному хосту в строке, например i.imgur.com"
                         Text="{Binding MessageImageAllowedHostsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <WrapPanel>
                <keepshell:NumericSettingField Style="{StaticResource Setting.PairCell}"
                                               Label="Высота картинки, px"
                                               Value="{Binding MessageImageMaxHeightPixels, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseMessageImageMaxHeightCommand}"
                                               DecreaseCommand="{Binding DecreaseMessageImageMaxHeightCommand}"
                                               IncreaseAutomationName="Увеличить высоту картинки"
                                               DecreaseAutomationName="Уменьшить высоту картинки" />

                <Button Style="{StaticResource Button.Secondary}"
                        Content="Вернуть хосты по умолчанию"
                        VerticalAlignment="Center"
                        Command="{Binding ResetMessageImageHostsCommand}"
                        Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>

        <Button Content="Сбросить все настройки чата"
                Style="{StaticResource Button.Ghost}"
                HorizontalAlignment="Left"
                Command="{Binding ResetAllCommand}"
                Margin="0,16,0,8" />

    </StackPanel>
</UserControl>
