<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.UpdateSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UpdateSettingsSectionViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PoproshaykaBot.Wpf;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <StackPanel>
            <TextBlock Text="{Binding CurrentVersionText}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       Margin="0,0,0,6" />

            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{DynamicResource Fg.Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusSeverity}"
                                         Value="Success">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource State.SuccessText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusSeverity}"
                                         Value="Error">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource State.ErrorText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusSeverity}"
                                         Value="Info">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource State.InfoText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <keepshell:ProgressStatusBlock StatusText="{Binding StatusText}"
                                           Value="{Binding DownloadProgress}"
                                           Maximum="100"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Параметры"
                       Style="{StaticResource Setting.GroupHeading}" />

            <CheckBox Content="Проверять обновления автоматически"
                      IsChecked="{Binding AutoCheckEnabled, Mode=TwoWay}"
                      Style="{StaticResource CheckBox.Default}"
                      Margin="0,0,0,8" />

            <StackPanel Style="{StaticResource Setting.DependentBlock}"
                        IsEnabled="{Binding AutoCheckEnabled}">
                <keepshell:NumericSettingField Label="Интервал проверки (часов)"
                                               Value="{Binding CheckIntervalHours, Mode=TwoWay}"
                                               IncreaseCommand="{Binding IncreaseIntervalCommand}"
                                               DecreaseCommand="{Binding DecreaseIntervalCommand}"
                                               IncreaseAutomationName="Увеличить интервал"
                                               DecreaseAutomationName="Уменьшить интервал"
                                               Margin="0,0,0,8" />
            </StackPanel>

            <CheckBox Content="Устанавливать обновление автоматически при выходе из приложения"
                      IsChecked="{Binding AutoInstall, Mode=TwoWay}"
                      Style="{StaticResource CheckBox.Default}"
                      Margin="0,4,0,8" />

            <CheckBox Content="Разрешить автообновление для сборки, требующей .NET (framework-dependent)"
                      IsChecked="{Binding AllowFrameworkDependent, Mode=TwoWay}"
                      Style="{StaticResource CheckBox.Default}"
                      Visibility="{Binding IsFrameworkDependentVisible, Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,0,8" />

            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Репозиторий (owner/repo)"
                           Style="{StaticResource Setting.RowLabel}" />
                <TextBox Style="{StaticResource TextBox.Form}"
                         Width="{DynamicResource Setting.ShortFieldWidth}"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="Репозиторий обновлений в формате owner/repo"
                         Text="{Binding RepositoryOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="{Binding DefaultRepositorySlug}" />
            </DockPanel>

            <TextBlock Text="{Binding RepositoryHintText}"
                       TextWrapping="Wrap"
                       Margin="200,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{DynamicResource Fg.Muted}" />
                        <Setter Property="FontSize"
                                Value="{DynamicResource Font.Size.S}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RepositoryHintSeverity}"
                                         Value="Success">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource State.SuccessText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RepositoryHintSeverity}"
                                         Value="Error">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource State.ErrorText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Действия"
                       Style="{StaticResource Setting.GroupHeading}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Проверить сейчас"
                        Command="{Binding CheckNowCommand}"
                        Style="{StaticResource Button.Secondary}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                <Button Content="Установить обновление"
                        Command="{Binding InstallUpdateCommand}"
                        Style="{StaticResource Button.Primary}"
                        VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

    </StackPanel>

</UserControl>
