<UserControl x:Class="PoproshaykaBot.Wpf.Views.Settings.HttpServerSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HttpServerSectionViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="600">

    <StackPanel>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Статус:"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ServerStatusText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       FontWeight="SemiBold"
                       keepshell:SeverityBrushBehavior.Foreground="{Binding ServerStatusSeverity}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Порт:"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Port}"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Foreground="{DynamicResource Fg.Primary}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="URL для OBS:"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ObsUrl}"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Foreground="{DynamicResource Fg.Primary}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Button Style="{StaticResource Button.Secondary}"
                    Content="Скопировать URL"
                    Command="{Binding CopyUrlCommand}"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Secondary}"
                    Content="Перезапустить сервер"
                    Command="{Binding RestartServerCommand}" />
        </StackPanel>

    </StackPanel>

</UserControl>
