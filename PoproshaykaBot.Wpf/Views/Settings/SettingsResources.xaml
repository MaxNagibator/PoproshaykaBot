<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="Setting.ContentWidth">780</sys:Double>

    <Style x:Key="Setting.SectionTitle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.XL}" />
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Margin"
                Value="0,0,0,12" />
    </Style>

    <Style x:Key="Setting.BlockHint"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Muted}" />
        <Setter Property="FontSize"
                Value="{DynamicResource Font.Size.S}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="Margin"
                Value="0,0,0,14" />
    </Style>

    <Thickness x:Key="Setting.BlockGap">0,0,0,16</Thickness>

    <Style x:Key="Setting.GroupTitle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource Fg.Primary}" />
        <Setter Property="FontWeight"
                Value="{DynamicResource Font.Weight.SemiBold}" />
        <Setter Property="Margin"
                Value="0,24,0,10" />
    </Style>

    <Style x:Key="Setting.BlockTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource Setting.GroupTitle}">
        <Setter Property="Margin"
                Value="0,20,0,10" />
    </Style>

    <Style x:Key="Setting.PairCell"
           TargetType="FrameworkElement">
        <Setter Property="Width"
                Value="328" />
        <Setter Property="Margin"
                Value="0,0,12,8" />
    </Style>

    <Style x:Key="Setting.GroupHeading"
           TargetType="TextBlock"
           BasedOn="{StaticResource Setting.BlockTitle}">
        <Setter Property="Margin"
                Value="0,28,0,10" />
    </Style>

    <Style x:Key="Setting.RowLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource Form.Label}">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Width"
                Value="188" />
        <Setter Property="Margin"
                Value="0,0,12,0" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="Setting.CheckCell"
           TargetType="CheckBox"
           BasedOn="{StaticResource CheckBox.Default}">
        <Setter Property="Width"
                Value="328" />
        <Setter Property="Margin"
                Value="0,0,12,8" />
    </Style>

    <Style x:Key="Setting.DependentBlock"
           TargetType="StackPanel">
        <Style.Triggers>
            <Trigger Property="IsEnabled"
                     Value="False">
                <Setter Property="Opacity"
                        Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
