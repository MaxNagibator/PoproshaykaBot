<UserControl x:Class="PoproshaykaBot.Wpf.Views.Controls.GameAutocompleteBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Controls"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameAutocompleteViewModel}"
             d:DesignWidth="320">
    <Grid>
        <TextBox x:Name="QueryBox"
                 Style="{StaticResource TextBox.Form}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 keepshell:PlaceholderBehavior.Placeholder="Начните вводить название игры" />

        <Popup IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=QueryBox}"
               Placement="Bottom"
               Width="{Binding ActualWidth, ElementName=QueryBox}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Focusable="False">
            <Border Style="{StaticResource Card}"
                    Padding="2"
                    MaxHeight="240">
                <ListBox ItemsSource="{Binding Suggestions}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                         Handler="OnSuggestionMouseUp" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Fg.Primary}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
