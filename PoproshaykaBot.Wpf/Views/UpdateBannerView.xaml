<UserControl x:Class="PoproshaykaBot.Wpf.Views.UpdateBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UpdateBannerViewModel}"
             d:DesignWidth="900"
             VerticalAlignment="Top"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">

    <Border Margin="20,12,20,0"
            Padding="0"
            CornerRadius="8"
            Background="{DynamicResource State.InfoSoft}"
            BorderBrush="{DynamicResource State.Info}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="4"
                    CornerRadius="8,0,0,8"
                    Background="{DynamicResource State.Info}" />

            <StackPanel Grid.Column="1"
                        Margin="14,10,10,10"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Download}"
                                              Width="16"
                                              Height="16"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource State.InfoText}" />
                    <TextBlock Text="{Binding Text}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Primary}" />
                </StackPanel>

                <ProgressBar Height="4"
                             Margin="26,8,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding DownloadProgress, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,10,14,10"
                        VerticalAlignment="Center">
                <Button Content="Обновить"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding InstallCommand}" />
                <Button Content="Пропустить"
                        Margin="8,0,0,0"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding SkipCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
