<UserControl x:Class="PoproshaykaBot.Wpf.Views.Dialogs.PollProfileEditDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PollProfileEditDialogViewModel}"
             MinWidth="460"
             MaxWidth="560">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   Style="{StaticResource TextBlock.Heading}"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <TextBlock Text="Вопрос голосования"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,0,0,4" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding PollTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="Вопрос голосования"
                     Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource TextBlock.Subtle}" Margin="0,0,0,4">
                <Run Text="Варианты ответа" />
                <Run Foreground="{DynamicResource Fg.Muted}"
                     FontSize="{DynamicResource Font.Size.S}"
                     Text=" (2–5, по одному на строку)" />
            </TextBlock>
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding ChoicesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     MinHeight="80"
                     MaxHeight="140"
                     VerticalScrollBarVisibility="Auto"
                     keepshell:PlaceholderBehavior.Placeholder="Вариант 1&#x0A;Вариант 2"
                     Margin="0,0,0,16" />

            <keepshell:NumericSettingField Label="Длительность (сек)"
                                           Value="{Binding DurationSeconds, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseDurationCommand}"
                                           DecreaseCommand="{Binding DecreaseDurationCommand}"
                                           IncreaseAutomationName="Увеличить длительность"
                                           DecreaseAutomationName="Уменьшить длительность"
                                           Margin="0,0,0,12" />

            <CheckBox Style="{StaticResource CheckBox.Default}"
                      Content="Баллы канала за голос"
                      IsChecked="{Binding ChannelPointsEnabled, Mode=TwoWay}"
                      Margin="0,0,0,8" />

            <keepshell:NumericSettingField Label="Баллы канала за голос"
                                           Value="{Binding ChannelPointsPerVote, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseChannelPointsCommand}"
                                           DecreaseCommand="{Binding DecreaseChannelPointsCommand}"
                                           IncreaseAutomationName="Увеличить стоимость голоса"
                                           DecreaseAutomationName="Уменьшить стоимость голоса"
                                           Margin="0,0,0,16">
                <keepshell:NumericSettingField.Style>
                    <Style TargetType="keepshell:NumericSettingField">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChannelPointsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </keepshell:NumericSettingField.Style>
            </keepshell:NumericSettingField>

            <TextBlock Text="Автозапуск"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,0,0,4" />
            <ComboBox Style="{StaticResource ComboBox.Form}"
                      ItemsSource="{Binding TriggerItems}"
                      SelectedItem="{Binding SelectedTriggerItem, Mode=TwoWay}"
                      Margin="0,0,0,12" />

            <keepshell:NumericSettingField Label="Кулдаун (мин)"
                                           Value="{Binding CooldownMinutes, Mode=TwoWay}"
                                           IncreaseCommand="{Binding IncreaseCooldownCommand}"
                                           DecreaseCommand="{Binding DecreaseCooldownCommand}"
                                           IncreaseAutomationName="Увеличить кулдаун"
                                           DecreaseAutomationName="Уменьшить кулдаун"
                                           Margin="0,0,0,20">
                <keepshell:NumericSettingField.Style>
                    <Style TargetType="keepshell:NumericSettingField">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTriggerItem.Event}"
                                         Value="None">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTriggerItem.Event}"
                                         Value="StreamOnline">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTriggerItem.Event}"
                                         Value="BroadcastProfileApplied">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </keepshell:NumericSettingField.Style>
            </keepshell:NumericSettingField>

            <TextBlock Text="Название профиля (необязательно)"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,0,0,4" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="Имя для сохранения профиля"
                     Margin="0,0,0,4" />

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource State.ErrorText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0"
                        MinWidth="88" />
                <Button Content="Сохранить профиль"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding SaveAsProfileCommand}"
                        Margin="0,0,8,0"
                        MinWidth="136" />
                <Button Content="Запустить"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding RunCommand}"
                        MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
