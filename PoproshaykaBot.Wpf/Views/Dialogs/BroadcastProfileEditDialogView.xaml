<UserControl x:Class="PoproshaykaBot.Wpf.Views.Dialogs.BroadcastProfileEditDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BroadcastProfileEditDialogViewModel}"
             MinWidth="500"
             MaxWidth="700"
             Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   Style="{StaticResource TextBlock.Heading}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Заголовок:"
                           VerticalAlignment="Top"
                           Margin="0,4,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource TextBox.Form}"
                         Text="{Binding ProfileTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="56"
                         VerticalScrollBarVisibility="Auto"
                         keepshell:PlaceholderBehavior.Placeholder="Заголовок трансляции, можно использовать {n}"
                         Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Foreground="{DynamicResource Fg.Muted}"
                           FontSize="{DynamicResource Font.Size.S}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="подставляется в {n}; +1 при следующем выходе в эфир" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                    <Setter Property="Text" Value="{Binding Preview}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Серия №:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <controls:NumericSettingField Grid.Row="2" Grid.Column="1"
                                              Value="{Binding CurrentNumber, Mode=TwoWay}"
                                              IncreaseCommand="{Binding IncreaseNumberCommand}"
                                              DecreaseCommand="{Binding DecreaseNumberCommand}"
                                              IncreaseAutomationName="Увеличить номер серии"
                                              DecreaseAutomationName="Уменьшить номер серии"
                                              Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Игра:"
                           VerticalAlignment="Top"
                           Margin="0,4,8,8" />
                <ContentControl Grid.Row="3" Grid.Column="1"
                                Content="{Binding Game}"
                                Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Теги:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource TextBox.Form}"
                         Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="через запятую"
                         Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Язык:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <ComboBox Grid.Row="5" Grid.Column="1"
                          Style="{StaticResource ComboBox.Form}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding Language, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="{Binding NameLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <TextBox Grid.Row="6" Grid.Column="1"
                         Style="{StaticResource TextBox.Form}"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         keepshell:PlaceholderBehavior.Placeholder="{Binding NamePlaceholder}"
                         Margin="0,0,0,8" />
            </Grid>

            <Grid Margin="0,0,0,8"
                  Visibility="{Binding IsObsSceneVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Сцена OBS:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          IsEditable="True"
                          ItemsSource="{Binding ObsScenes}"
                          Text="{Binding ObsSceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Отмена"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"
                    MinWidth="96" />
            <Button Content="{Binding ConfirmButtonText}"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="120" />
        </StackPanel>
    </Grid>
</UserControl>
