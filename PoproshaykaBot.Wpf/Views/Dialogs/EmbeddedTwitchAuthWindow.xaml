<Window x:Class="PoproshaykaBot.Wpf.Views.Dialogs.EmbeddedTwitchAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:keepshell="https://schemas.keepshell.dev/wpf"
        xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:EmbeddedTwitchAuthDialogViewModel}"
        Title="{Binding Title}"
        Height="760"
        Width="620"
        MinHeight="480"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{DynamicResource Font.Sans}"
        FontSize="{DynamicResource Font.Size.M}">

    <Window.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding CloseDialogCommand}" />
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Chrome.Button.Close}"
                            keepshell:ChromeAction.Action="Close"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть окно авторизации">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Style="{StaticResource Chrome.Glyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0">
            <wv2:WebView2 x:Name="WebView"
                          Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}" />

            <controls:EmptyState Icon="{x:Static iconPacks:PackIconLucideKind.TriangleAlert}"
                                 Heading="{Binding ErrorHeading}"
                                 Description="{Binding ErrorDescription}"
                                 DescriptionMaxWidth="360"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Size.S}"
                           keepshell:SeverityBrushBehavior.Foreground="{Binding StatusSeverity}"
                           Margin="0,0,12,0" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Скачать WebView2 Runtime"
                            Command="{Binding DownloadRuntimeCommand}"
                            Visibility="{Binding CanDownloadRuntime, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Ghost}"
                            Content="{Binding CloseButtonText}"
                            Command="{Binding CloseDialogCommand}"
                            MinWidth="96" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
