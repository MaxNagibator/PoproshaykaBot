<UserControl x:Class="PoproshaykaBot.Wpf.Views.Dialogs.PointTermDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PointTermDialogViewModel}"
             MinWidth="420"
             MaxWidth="520">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource TextBlock.Heading}"
                   Margin="0,0,0,16" />

        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Единственное:"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Style="{StaticResource TextBox.Form}"
                     Text="{Binding Singular, Mode=TwoWay}"
                     Margin="8,0,0,8" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="От 2 до 4:"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Style="{StaticResource TextBox.Form}"
                     Text="{Binding Few, Mode=TwoWay}"
                     Margin="8,0,0,8" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Множественное:"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Style="{StaticResource TextBox.Form}"
                     Text="{Binding Many, Mode=TwoWay}"
                     Margin="8,0,0,0" />
        </Grid>

        <Border Padding="12"
                CornerRadius="{DynamicResource Radius.M}"
                Background="{DynamicResource Bg.SurfaceAlt}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1"
                Margin="0,0,0,16">
            <TextBlock Text="{Binding Preview}"
                       Foreground="{DynamicResource Fg.Primary}"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="По умолчанию"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding ResetDefaultsCommand}"
                    Margin="0,0,8,0"
                    MinWidth="120" />
            <Button Content="Отмена"
                    Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"
                    MinWidth="96" />
            <Button Content="ОК"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="120" />
        </StackPanel>
    </StackPanel>
</UserControl>
