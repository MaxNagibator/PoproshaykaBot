<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.CredentialsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CredentialsPageViewModel}"
             d:DesignHeight="520"
             d:DesignWidth="688">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">

            <TextBlock Text="Канал"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsChannelReadOnly}"
                     keepshell:PlaceholderBehavior.Placeholder="название_канала"
                     Margin="0,0,0,4" />
            <CheckBox Content="Определить автоматически по аккаунту стримера"
                      IsChecked="{Binding AutoDetectChannel, Mode=TwoWay}"
                      Margin="0,0,0,4" />
            <TextBlock Text="{Binding ChannelStatusText}"
                       keepshell:SeverityBrushBehavior.Foreground="{Binding ChannelStatusSeverity}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Visibility="{Binding ChannelStatusText, Converter={StaticResource NullToVisibility}}"
                       Margin="0,0,0,12" />

            <TextBlock Text="Client ID"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <keepshell:RevealableTextBox Password="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,4" />

            <TextBlock Text="Client Secret"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <keepshell:RevealableTextBox Password="{Binding ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,4" />

            <TextBlock Text="{Binding ClientStatusText}"
                       keepshell:SeverityBrushBehavior.Foreground="{Binding ClientStatusSeverity}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Visibility="{Binding ClientStatusText, Converter={StaticResource NullToVisibility}}"
                       Margin="0,0,0,12" />

            <TextBlock Text="Redirect URI"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Margin="0,0,0,4" />
            <TextBox Style="{StaticResource TextBox.Form}"
                     Text="{Binding RedirectUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     keepshell:PlaceholderBehavior.Placeholder="http://localhost:3000"
                     Margin="0,0,0,4" />
            <TextBlock Text="{Binding PortHintText}"
                       Foreground="{DynamicResource Fg.Muted}"
                       FontSize="{DynamicResource Font.Size.S}"
                       Visibility="{Binding PortHintText, Converter={StaticResource NullToVisibility}}"
                       Margin="0,0,0,12" />

            <TextBlock Text="{Binding ValidationErrorText}"
                       Foreground="{DynamicResource State.ErrorText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Visibility="{Binding ValidationErrorText, Converter={StaticResource NullToVisibility}}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
