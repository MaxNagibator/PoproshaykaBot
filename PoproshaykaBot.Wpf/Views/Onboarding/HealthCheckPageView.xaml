<UserControl x:Class="PoproshaykaBot.Wpf.Views.Onboarding.HealthCheckPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Onboarding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HealthCheckPageViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="688">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18">

            <TextBlock Text="OBS Browser Source"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Font.Size.M}"
                       Foreground="{DynamicResource Fg.Primary}"
                       Margin="0,0,0,6" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Адрес для Browser Source в OBS: "
                           Foreground="{DynamicResource Fg.Secondary}"
                           FontSize="{DynamicResource Font.Size.S}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding OverlayUrl}"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.S}"
                           Foreground="{DynamicResource Fg.Primary}"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding OverlayHint}"
                       Foreground="{DynamicResource Fg.Secondary}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <Button Style="{StaticResource Button.Secondary}"
                    Content="Открыть в браузере"
                    Command="{Binding OpenOverlayInBrowserCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20" />

            <Separator Background="{DynamicResource Border.Subtle}"
                       Margin="0,0,0,16" />

            <TextBlock Text="Статус бота в чате"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Font.Size.M}"
                       Foreground="{DynamicResource Fg.Primary}"
                       Margin="0,0,0,6" />

            <TextBlock Text="{Binding BotStatusText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BotStatusKnown}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource State.SuccessText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Separator Background="{DynamicResource Border.Subtle}"
                       Margin="0,0,0,16" />

            <TextBlock Text="Тест отправки сообщения"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Font.Size.M}"
                       Foreground="{DynamicResource Fg.Primary}"
                       Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,6">
                <TextBox Text="{Binding ChatTestMessage, UpdateSourceTrigger=PropertyChanged}"
                         Width="300"
                         Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Secondary}"
                        Content="Отправить"
                        Command="{Binding SendChatTestCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ChatTestStatusText}"
                       FontSize="{DynamicResource Font.Size.S}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChatTestSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource State.SuccessText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChatTestError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource State.ErrorText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>

</UserControl>
