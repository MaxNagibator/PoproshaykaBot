<UserControl x:Class="PoproshaykaBot.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:tiles="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:dashboard="clr-namespace:PoproshaykaBot.Wpf.Infrastructure.Dashboard"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <DataTemplate x:Key="DashboardTileChrome"
                      DataType="{x:Type tiles:DashboardTileViewModel}">
            <Border x:Name="TileRoot"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.M}"
                    Padding="0"
                    Margin="4"
                    SnapsToDevicePixels="True">
                <Border.Resources>
                    <Style x:Key="Button.Icon"
                           TargetType="Button"
                           BasedOn="{StaticResource Button.Ghost}">
                        <Setter Property="Width"
                                Value="{DynamicResource Control.Height.Compact}" />
                        <Setter Property="Height"
                                Value="{DynamicResource Control.Height.Compact}" />
                        <Setter Property="MinHeight"
                                Value="{DynamicResource Control.Height.Compact}" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Center" />
                    </Style>
                </Border.Resources>

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ToggleCollapseCommand}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header"
                                            Value="Свернуть плитку" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}"
                                                     Value="True">
                                            <Setter Property="Header"
                                                    Value="Развернуть плитку" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                <DockPanel LastChildFill="True">
                    <Border x:Name="TileHeaderBar"
                            DockPanel.Dock="Top"
                            Background="{DynamicResource Bg.SurfaceAlt}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="9,9,0,0"
                            Padding="12,7,8,7"
                            SnapsToDevicePixels="True">
                    <DockPanel x:Name="TileHeader"
                               LastChildFill="True">
                        <StackPanel x:Name="TileActions"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ItemsControl x:Name="TileToolbar"
                                          Style="{StaticResource Toolbar.ItemsControl}"
                                          ItemsSource="{Binding HeaderActions}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Opacity="0.55" />

                            <Button x:Name="TileCollapse"
                                    Style="{StaticResource Button.Icon}"
                                    Opacity="0.55"
                                    Command="{Binding ToggleCollapseCommand}"
                                    AutomationProperties.Name="Свернуть или развернуть плитку">
                                <iconPacks:PackIconLucide Width="14"
                                                          Height="14">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind"
                                                    Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCollapsed}"
                                                             Value="True">
                                                    <Setter Property="Kind"
                                                            Value="ChevronRight" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                        </StackPanel>

                        <iconPacks:PackIconLucide x:Name="TileIcon"
                                                  DockPanel.Dock="Left"
                                                  Kind="{Binding Icon}"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource Accent.Text}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />

                        <dashboard:TileHeaderLine VerticalAlignment="Center">
                        <TextBlock x:Name="TileTitle"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontFamily="{DynamicResource Font.Sans}"
                                   FontSize="{DynamicResource Font.Size.M}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />

                        <DockPanel x:Name="TileStatus"
                                   Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   ClipToBounds="True"
                                   ToolTip="{Binding HeaderStatus.Description}"
                                   Visibility="{Binding HeaderStatus, Converter={StaticResource NullToVisibility}}">
                            <Ellipse DockPanel.Dock="Left"
                                     Width="7"
                                     Height="7"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     keepshell:SeverityBrushBehavior.Fill="{Binding HeaderStatus.Severity}" />
                            <TextBlock x:Name="TileStatusText"
                                       Text="{Binding HeaderStatus.Text}"
                                       FontFamily="{DynamicResource Font.Sans}"
                                       FontSize="{DynamicResource Font.Size.S}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       keepshell:SeverityBrushBehavior.Foreground="{Binding HeaderStatus.Severity}"
                                       AutomationProperties.Name="{Binding HeaderStatus.Description, NotifyOnTargetUpdated=True}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Binding.TargetUpdated="OnTileStatusUpdated" />
                        </DockPanel>
                        </dashboard:TileHeaderLine>
                    </DockPanel>
                    </Border>

                    <Border x:Name="TileBody"
                            Padding="14,10,14,14"
                            Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility"
                                        Value="Auto" />
                                <Setter Property="VerticalAlignment"
                                        Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FillsAvailableSpace}"
                                                 Value="True">
                                        <Setter Property="VerticalScrollBarVisibility"
                                                Value="Disabled" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Stretch" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GrowsWithSpace}"
                                                 Value="True">
                                        <Setter Property="VerticalAlignment"
                                                Value="Stretch" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=(dashboard:DashboardTileSlot.Fills), RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                 Value="True">
                                        <Setter Property="VerticalAlignment"
                                                Value="Stretch" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ContentControl Content="{Binding}" />
                    </ScrollViewer>
                    </Border>
                </DockPanel>

                <Border x:Name="TileStrip"
                        Background="{DynamicResource Bg.SurfaceAlt}"
                        CornerRadius="9"
                        Width="{Binding Path=(tiles:DashboardTileViewModel.ScaledCollapsedStripWidth), Mode=OneWay}"
                        Padding="0,8,0,8"
                        Visibility="Collapsed"
                        SnapsToDevicePixels="True">
                    <DockPanel LastChildFill="True">
                        <iconPacks:PackIconLucide DockPanel.Dock="Top"
                                                  Kind="{Binding Icon}"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource Accent.Text}"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,6" />

                        <Button x:Name="TileStripExpand"
                                DockPanel.Dock="Top"
                                Style="{StaticResource Button.Icon}"
                                Opacity="0.55"
                                Command="{Binding ToggleCollapseCommand}"
                                ToolTip="Развернуть плитку"
                                AutomationProperties.Name="Развернуть плитку"
                                Margin="0,0,0,6">
                            <iconPacks:PackIconLucide Kind="ChevronRight"
                                                      Width="14"
                                                      Height="14" />
                        </Button>

                        <Ellipse x:Name="TileStripStatus"
                                 DockPanel.Dock="Top"
                                 Width="7"
                                 Height="7"
                                 Margin="0,0,0,8"
                                 HorizontalAlignment="Center"
                                 ToolTip="{Binding HeaderStatus.Description}"
                                 keepshell:SeverityBrushBehavior.Fill="{Binding HeaderStatus.Severity}"
                                 Visibility="{Binding HeaderStatus, Converter={StaticResource NullToVisibility}}" />

                        <TextBlock Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   AutomationProperties.HelpText="{Binding HeaderStatus.Description}"
                                   FontFamily="{DynamicResource Font.Sans}"
                                   FontSize="{DynamicResource Font.Size.M}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Border x:Name="TileShield"
                        Background="Transparent"
                        Focusable="True"
                        Cursor="SizeAll"
                        AutomationProperties.Name="{Binding Title}"
                        PreviewMouseLeftButtonDown="OnShieldMouseDown"
                        PreviewMouseMove="OnShieldMouseMove"
                        PreviewMouseLeftButtonUp="OnShieldMouseUp"
                        Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

                <Button x:Name="TileEditCollapse"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding ToggleCollapseCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,7,8,0"
                        Visibility="Collapsed"
                        ToolTip="Свернуть или развернуть плитку"
                        AutomationProperties.Name="Свернуть или развернуть плитку">
                    <iconPacks:PackIconLucide Width="14"
                                              Height="14">
                        <iconPacks:PackIconLucide.Style>
                            <Style TargetType="iconPacks:PackIconLucide">
                                <Setter Property="Kind"
                                        Value="ChevronDown" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}"
                                                 Value="True">
                                        <Setter Property="Kind"
                                                Value="ChevronRight" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconLucide.Style>
                    </iconPacks:PackIconLucide>
                </Button>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}"
                             Value="True">
                    <Setter TargetName="TileHeaderBar"
                            Property="CornerRadius"
                            Value="9" />
                    <Setter TargetName="TileHeaderBar"
                            Property="BorderThickness"
                            Value="0" />
                    <Setter TargetName="TileRoot"
                            Property="VerticalAlignment"
                            Value="Top" />
                </DataTrigger>

                <DataTrigger Binding="{Binding ContentFillsTile}"
                             Value="True">
                    <Setter TargetName="TileBody"
                            Property="Padding"
                            Value="0" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsCollapsedToStrip}"
                             Value="True">
                    <Setter TargetName="TileHeaderBar"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="TileStrip"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="TileRoot"
                            Property="VerticalAlignment"
                            Value="Stretch" />
                    <Setter TargetName="TileEditCollapse"
                            Property="HorizontalAlignment"
                            Value="Center" />
                    <Setter TargetName="TileEditCollapse"
                            Property="Margin"
                            Value="0,28,0,0" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsLayoutEditing}"
                             Value="True">
                    <Setter TargetName="TileEditCollapse"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter TargetName="TileCollapse"
                            Property="Visibility"
                            Value="Hidden" />
                    <Setter TargetName="TileStripExpand"
                            Property="Visibility"
                            Value="Hidden" />
                </DataTrigger>

                <Trigger SourceName="TileRoot"
                         Property="IsMouseOver"
                         Value="True">
                    <Setter TargetName="TileToolbar"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="TileCollapse"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="TileStripExpand"
                            Property="Opacity"
                            Value="1" />
                </Trigger>

                <Trigger SourceName="TileRoot"
                         Property="IsKeyboardFocusWithin"
                         Value="True">
                    <Setter TargetName="TileToolbar"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="TileCollapse"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="TileStripExpand"
                            Property="Opacity"
                            Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Bg.Base}"
                Padding="8"
                Visibility="{Binding HasTiles, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <ScrollViewer x:Name="BandsScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="BandsGrid" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Canvas x:Name="EditOverlay"
                IsHitTestVisible="False" />

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="16"
                MaxWidth="520"
                Padding="14,9"
                IsHitTestVisible="False"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource State.Warning}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.M}"
                Visibility="{Binding EditNotice, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Info}"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Foreground="{DynamicResource State.WarningText}" />

                <TextBlock x:Name="EditNoticeText"
                           Text="{Binding EditNotice}"
                           MaxWidth="460"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg.Primary}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>

        <controls:EmptyState Icon="LayoutDashboard"
                             Heading="Плиток пока нет"
                             Description="Плитки панели появятся здесь после регистрации."
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="20"
                             Visibility="{Binding HasTiles, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
