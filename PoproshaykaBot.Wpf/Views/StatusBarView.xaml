<UserControl x:Class="PoproshaykaBot.Wpf.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <DataTemplate x:Key="MonitoringIndicator" DataType="{x:Type vm:StreamMonitoringIndicatorViewModel}">
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0"
                        ToolTip="{Binding Tooltip}"
                        Visibility="{Binding IsReported, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Width="8"
                         Height="8"
                         VerticalAlignment="Center"
                         keepshell:SeverityBrushBehavior.Fill="{Binding Severity}" />
                <TextBlock Text="{Binding Text}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg.Secondary}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="14,5">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="16,0,0,0"
                        DataContext="{Binding DebugBanner}"
                        AutomationProperties.Name="Отладочный канал"
                        ToolTip="{Binding Text}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="TextElement.Foreground"
                                Value="{DynamicResource State.InfoText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSendingAllowed}"
                                         Value="True">
                                <Setter Property="TextElement.Foreground"
                                        Value="{DynamicResource State.WarningText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="1"
                        Margin="0,1,16,1"
                        Background="{DynamicResource Border.Subtle}" />

                <iconPacks:PackIconLucide Kind="{x:Static iconPacks:PackIconLucideKind.Bug}"
                                          Width="13"
                                          Height="13"
                                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding ShortText}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap" />
            </StackPanel>

            <DockPanel DockPanel.Dock="Right"
                       LastChildFill="True"
                       ClipToBounds="True"
                       DataContext="{Binding StreamMonitoring}"
                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Border DockPanel.Dock="Left"
                        Width="1"
                        Margin="14,1,0,1"
                        Background="{DynamicResource Border.Subtle}" />

                <ContentPresenter DockPanel.Dock="Right"
                                  Content="{Binding Broadcaster}"
                                  ContentTemplate="{StaticResource MonitoringIndicator}" />
                <ContentPresenter DockPanel.Dock="Right"
                                  Content="{Binding Bot}"
                                  ContentTemplate="{StaticResource MonitoringIndicator}" />

                <TextBlock Text="Мониторинг стрима"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Мониторинг стрима"
                           Foreground="{DynamicResource Fg.Secondary}"
                           Opacity="0.7" />
            </DockPanel>

            <DockPanel DockPanel.Dock="Right"
                       LastChildFill="True"
                       ClipToBounds="True">
                <Ellipse DockPanel.Dock="Left"
                         Width="8"
                         Height="8"
                         VerticalAlignment="Center"
                         keepshell:SeverityBrushBehavior.Fill="{Binding StatusSeverity}" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"
                           Foreground="{DynamicResource Fg.Secondary}" />
            </DockPanel>

            <TextBlock Text="Тяните разделители и плитки; Ctrl+Z – отмена, Escape – выход"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Fg.Muted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOverviewSelected}"
                                               Value="True" />
                                    <Condition Binding="{Binding Overview.IsEditing}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>
