<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ObsOutputCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ObsOutputCardViewModel}"
             d:DesignWidth="320">

    <UserControl.Resources>
        <Style x:Key="ObsCardAccent"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness"
                    Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="Active">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Paused">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Error">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObsCardDot"
               TargetType="Ellipse">
            <Setter Property="Width"
                    Value="10" />
            <Setter Property="Height"
                    Value="10" />
            <Setter Property="Fill"
                    Value="{DynamicResource Fg.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="Active">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Paused">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Error">
                    <Setter Property="Fill"
                            Value="{DynamicResource State.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObsCardStateText"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="Active">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObsCardHealth"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthSeverity}"
                             Value="Warning">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthSeverity}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObsCardMeta"
               TargetType="TextBlock"
               BasedOn="{StaticResource TextBlock.Subtle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MetaIsError}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource State.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ObsCardAccent}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="True"
                       Margin="0,0,0,8">
                <Ellipse DockPanel.Dock="Left"
                         Style="{StaticResource ObsCardDot}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource ObsCardStateText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="–:–:–"
                               Style="{StaticResource TextBlock.Mono}"
                               FontSize="{DynamicResource Font.Size.XL}"
                               Visibility="{Binding HasTimecode, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Timecode, Converter={StaticResource Timecode}}"
                               Style="{StaticResource TextBlock.Mono}"
                               FontSize="{DynamicResource Font.Size.XL}"
                               Visibility="{Binding HasTimecode, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock Text="{Binding Health}"
                           Style="{StaticResource ObsCardHealth}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Health, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding Meta}"
                       Style="{StaticResource ObsCardMeta}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding Meta, Converter={StaticResource NullToVisibility}}" />

            <WrapPanel Grid.Row="3">
                <Button Style="{StaticResource Button.Secondary}"
                        Margin="0,0,8,0"
                        Content="{Binding PrimaryButtonText}"
                        Command="{Binding InvokePrimaryCommand}" />

                <Button Style="{StaticResource Button.Ghost}"
                        Content="{Binding SecondaryButtonText}"
                        Command="{Binding InvokeSecondaryCommand}"
                        Visibility="{Binding ShowsSecondaryButton, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
