<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ObsSourceMeterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ObsSourceMeterViewModel}"
             d:DesignWidth="320">

    <StackPanel Margin="0,0,0,8">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StateText}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource TextBlock.Subtle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}"
                                         Value="Missing">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource State.WarningText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding DisplayName}"
                       ToolTip="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DockPanel>

        <ProgressBar Height="6"
                     Margin="0,4,0,0"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Level, Mode=OneWay}"
                     Visibility="{Binding ShowsLevel, Converter={StaticResource BoolToVisibility}}"
                     keepshell:SeverityBrushBehavior.Foreground="{Binding LevelSeverity}" />
    </StackPanel>
</UserControl>
