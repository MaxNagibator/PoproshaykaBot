<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ChatDisplayTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ChatDisplayTileViewModel}"
             d:DesignWidth="380"
             d:DesignHeight="460">

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg.SurfaceAlt}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,6"
                Margin="0,0,0,6"
                Visibility="{Binding AccountChangeRequiresRestart, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Аккаунт отображения чата изменён. Перезапустите приложение, чтобы чат открылся под новым аккаунтом."
                       Style="{StaticResource TextBlock.Subtle}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
        <wv2:WebView2 x:Name="WebView"
                      ZoomFactor="{Binding ZoomFactor, Mode=TwoWay}">
            <wv2:WebView2.Style>
                <Style TargetType="wv2:WebView2">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFallback}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLayoutEditing}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsModalDialogOpen}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </wv2:WebView2.Style>
        </wv2:WebView2>

        <controls:EmptyState Icon="MessageSquare"
                             Heading="Чат скрыт"
                             DescriptionMaxWidth="320"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center">
            <controls:EmptyState.Style>
                <Style TargetType="controls:EmptyState">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Setter Property="Description"
                            Value="Окно чата вернётся, когда закончится настройка дашборда." />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLayoutEditing}"
                                           Value="True" />
                                <Condition Binding="{Binding HasFallback}"
                                           Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsModalDialogOpen}"
                                           Value="True" />
                                <Condition Binding="{Binding HasFallback}"
                                           Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Description"
                                    Value="Окно чата вернётся, когда закроется диалог." />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:EmptyState.Style>
        </controls:EmptyState>

        <controls:EmptyState Icon="MessageSquareWarning"
                             Heading="{Binding FallbackHeading}"
                             Description="{Binding FallbackDescription}"
                             ActionText="Скачать WebView2 Runtime"
                             ActionCommand="{Binding FallbackActionCommand}"
                             DescriptionMaxWidth="320"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Visibility="{Binding HasFallback, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
