<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.BroadcastProfilesTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BroadcastProfilesTileViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="780">

    <UserControl.Resources>
        <Style x:Key="ProfileCard"
               TargetType="Border"
               BasedOn="{StaticResource Card.Inset}">
            <Setter Property="Margin"
                    Value="0,0,8,8" />
            <Setter Property="Padding"
                    Value="10" />
        </Style>

        <Style x:Key="ProfileCardMeta"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.XS}" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ProfileCardAction"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinHeight"
                    Value="0" />
            <Setter Property="Padding"
                    Value="10,3" />
            <Setter Property="FontSize"
                    Value="{DynamicResource Font.Size.S}" />
        </Style>

        <DataTemplate x:Key="ProfileCardTemplate"
                      DataType="{x:Type vm:BroadcastProfileItemViewModel}">
            <Border x:Name="Card"
                    Style="{StaticResource ProfileCard}"
                    AutomationProperties.ItemStatus="{Binding ActiveStatusText}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Применить" Command="{Binding ApplyCommand}" />
                        <Separator />
                        <MenuItem Header="Редактировать…" Command="{Binding EditCommand}" />
                        <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" />
                        <Separator />
                        <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ActiveEdge"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Width="3"
                            Margin="-8,-4,0,-4"
                            HorizontalAlignment="Left"
                            CornerRadius="1.5"
                            Background="{DynamicResource State.Success}"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                    <Grid x:Name="CardHeader"
                          Grid.Row="0"
                          Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="64" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1"
                                Style="{StaticResource Badge}"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNumberPlaceholder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding NumberBadge}"
                                       FontFamily="{DynamicResource Font.Mono}" />
                        </Border>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="{DynamicResource Font.Size.M}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="1"
                                MinHeight="{Binding ActualHeight, ElementName=CardActions}">
                        <TextBlock Text="{Binding TitleDisplay}"
                                   Style="{StaticResource ProfileCardMeta}"
                                   FontStyle="Italic"
                                   Margin="0,2,0,0"
                                   ToolTip="{Binding TitleDisplay}"
                                   Visibility="{Binding HasTitleDisplay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding MetaLine}"
                                   Style="{StaticResource ProfileCardMeta}"
                                   Margin="0,2,0,0"
                                   ToolTip="{Binding MetaLine}"
                                   Visibility="{Binding HasMetaLine, Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>

                    <Grid x:Name="CardActions"
                          Grid.Row="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Opacity="0"
                          IsHitTestVisible="False"
                          ToolTip="{Binding MetaLine}"
                          ToolTipService.IsEnabled="{Binding HasMetaLine}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{Binding Background, ElementName=Card}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5"
                                                     EndPoint="1,0.5">
                                    <GradientStop Color="Transparent"
                                                  Offset="0" />
                                    <GradientStop Color="Black"
                                                  Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>

                        <WrapPanel Grid.Column="1"
                                   Background="{Binding Background, ElementName=Card}">
                            <Button Command="{Binding ApplyCommand}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ProfileCardAction}">
                                        <Setter Property="Content"
                                                Value="Применить" />
                                        <Setter Property="ToolTip"
                                                Value="Применить профиль к каналу" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApplyInFlight}"
                                                         Value="True">
                                                <Setter Property="Content"
                                                        Value="Применяю…" />
                                                <Setter Property="ToolTip"
                                                        Value="Профиль применяется к каналу" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding HasNumberPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="–"
                                        Command="{Binding DecrementNumberCommand}"
                                        Style="{StaticResource ProfileCardAction}"
                                        Padding="8,3"
                                        ToolTip="Уменьшить номер"
                                        AutomationProperties.Name="Уменьшить номер" />
                                <TextBlock Text="{Binding NumberBadge}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.S}"
                                           Foreground="{DynamicResource Fg.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="6,0" />
                                <Button Content="+"
                                        Command="{Binding IncrementNumberCommand}"
                                        Style="{StaticResource ProfileCardAction}"
                                        Padding="8,3"
                                        ToolTip="Увеличить номер"
                                        AutomationProperties.Name="Увеличить номер" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>

                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card"
                         Property="IsMouseOver"
                         Value="True">
                    <Setter TargetName="CardActions"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="CardActions"
                            Property="IsHitTestVisible"
                            Value="True" />
                </Trigger>

                <Trigger SourceName="Card"
                         Property="IsKeyboardFocusWithin"
                         Value="True">
                    <Setter TargetName="CardActions"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="CardActions"
                            Property="IsHitTestVisible"
                            Value="True" />
                </Trigger>

                <DataTrigger Binding="{Binding IsApplyInFlight}"
                             Value="True">
                    <Setter TargetName="CardActions"
                            Property="Opacity"
                            Value="1" />
                    <Setter TargetName="CardActions"
                            Property="IsHitTestVisible"
                            Value="True" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding UnsavedNotice}"
                   FontSize="{DynamicResource Font.Size.S}"
                   Foreground="{DynamicResource State.WarningText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding UnsavedNotice, Converter={StaticResource NullToVisibility}}" />

        <TextBlock x:Name="StatusLine"
                   Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource State.ErrorText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="2"
                   Text="Профилей нет – добавьте кнопкой «+» в заголовке"
                   Style="{StaticResource TextBlock.Subtle}"
                   FontSize="{DynamicResource Font.Size.S}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}" />

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Items}"
                          Margin="0,0,-8,0"
                          VerticalAlignment="Top"
                          ItemTemplate="{StaticResource ProfileCardTemplate}"
                          SizeChanged="OnCardsSizeChanged">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="1">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
