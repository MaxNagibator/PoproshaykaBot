<UserControl x:Class="PoproshaykaBot.Wpf.Views.Tiles.ObsInfoTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keepshell="https://schemas.keepshell.dev/wpf"
             xmlns:vm="clr-namespace:PoproshaykaBot.Wpf.ViewModels.Tiles"
             xmlns:behaviors="clr-namespace:PoproshaykaBot.Wpf.Infrastructure.Behaviors"
             xmlns:controls="clr-namespace:KeepShell.Views.Controls;assembly=KeepShell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ObsInfoTileViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="360">

    <StackPanel>
        <DockPanel LastChildFill="True"
                   Margin="0,0,0,10">
            <Border DockPanel.Dock="Right"
                    Style="{StaticResource Badge}"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}"
                    keepshell:SeverityBrushBehavior.SoftBackground="{Binding ToastSeverity}"
                    keepshell:SeverityBrushBehavior.BorderBrush="{Binding ToastSeverity}">
                <TextBlock Text="{Binding ToastText}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           keepshell:SeverityBrushBehavior.Foreground="{Binding ToastSeverity}" />
            </Border>

            <TextBlock Text="{Binding ConnectionText}"
                       ToolTip="{Binding ConnectionToolTip}"
                       FontWeight="SemiBold"
                       behaviors:StreamStatusBrushBehavior.Foreground="{Binding ConnectionStatus}" />
        </DockPanel>

        <DockPanel LastChildFill="True"
                   Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left"
                       Text="Сцена"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding SceneName}"
                       ToolTip="{Binding SceneName}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DockPanel>

        <ContentControl Content="{Binding StreamCard}"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}" />

        <ContentControl Content="{Binding RecordCard}"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Visibility="{Binding IsUnavailable, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Аудиоисточники"
                       Style="{StaticResource TextBlock.Subtle}"
                       Margin="0,0,0,6" />

            <ItemsControl ItemsSource="{Binding AudioSources}"
                          Visibility="{Binding HasAudioSources, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyState Icon="Mic"
                                 IconSize="22"
                                 Heading="Источники не найдены"
                                 Description="Включите OBS-интеграцию и настройте аудиоисточники."
                                 HorizontalAlignment="Stretch"
                                 Visibility="{Binding HasAudioSources, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
